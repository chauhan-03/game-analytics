model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "daily_activity", "retention_curve", "cohort_retention", "new_players", "cookie_cats_players", "ab_test_players", "kpi_summary", "review_themes", "review_games"]

ref table daily_activity
ref table retention_curve
ref table cohort_retention
ref table new_players
ref table cookie_cats_players
ref table ab_test_players
ref table kpi_summary
ref table review_themes
ref table review_games
